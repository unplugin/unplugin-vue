{
  "name": "unplugin-vue",
  "type": "module",
  "version": "8.0.0",
  "description": "Transform Vue 3 SFC to JavaScript.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/unplugin/unplugin-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unplugin/unplugin-vue.git"
  },
  "bugs": {
    "url": "https://github.com/unplugin/unplugin-vue/issues"
  },
  "keywords": [
    "vue",
    "sfc",
    "unplugin",
    "vite",
    "webpack",
    "rollup",
    "esbuild"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./api": "./dist/api.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./farm": "./dist/farm.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./rspack": "./dist/rspack.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "test": "vitest",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "release": "bumpp",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.25"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@vue/reactivity": "^3.5.44",
    "obug": "^3.0.0",
    "unplugin": "^3.7.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@babel/types": "^8.0.8",
    "@farmfe/core": "2.0.0-nightly-20250411141103",
    "@sxzz/eslint-config": "^8.8.0",
    "@sxzz/prettier-config": "^2.3.3",
    "@sxzz/test-utils": "^0.5.20",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.0.5",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "premove": "^4.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.65.1",
    "source-map-js": "^1.2.2",
    "tsdown": "^0.23.3",
    "tsdown-preset-sxzz": "^0.7.1",
    "typescript": "^6.0.3",
    "unplugin-oxc": "^0.6.2",
    "vitest": "^5.0.5",
    "vue": "^3.6.0-rc.13",
    "webpack": "^5.112.2"
  },
  "prettier": "@sxzz/prettier-config"
}
